{
  "name": "corner-table-mechanics",
  "private": true,
  "version": "0.1.0",
  "description": "Calculs RDM « coin de table » : pré-dimensionnement en résistance des matériaux, 100 % dans le navigateur.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
